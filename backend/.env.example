# Copia este archivo como .env y completa la contraseña.
# El .env real nunca se sube al repositorio.

ENTORNO=desarrollo

# Base de datos. La API se conecta con el rol app_precios, que puede leer y escribir
# pero no puede modificar ni borrar precios ya cargados (RNF010).
PGHOST=localhost
PGPORT=5432
PGDATABASE=transparencia_precios
PGUSER=app_precios
PGPASSWORD=

# Firma de los tokens de sesión (RNF001). Al menos 32 caracteres aleatorios.
# Para generar uno:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si cambia, todas las sesiones abiertas caducan.
JWT_SECRETO=

# Dominios desde los que el navegador puede llamar a la API, separados por comas.
# En desarrollo puede quedar vacío: se admite cualquier puerto de localhost.
# Ejemplo en producción: CORS_ORIGENES=https://panel-transparencia.onrender.com
CORS_ORIGENES=

# Clave de OpenRouteService (RNF017), para distancias por calle y búsqueda de direcciones.
# Se obtiene gratis en https://openrouteservice.org (Dashboard -> Tokens).
# Sin clave, la API funciona igual: la distancia se estima en línea recta (RNF008).
ORS_CLAVE=
