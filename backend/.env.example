# Copia este archivo como .env y completa la contraseña.
# El .env real nunca se sube al repositorio.

ENTORNO=desarrollo

# Base de datos. La API se conecta con el rol app_precios, que puede leer y escribir
# pero no puede modificar ni borrar precios ya cargados (RNF010).
PGHOST=localhost
PGPORT=5432
PGDATABASE=transparencia_precios
PGUSER=app_precios
PGPASSWORD=
